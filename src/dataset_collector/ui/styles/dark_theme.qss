/* Dataset_Collector Dark Theme */

* {
    font-family: "Segoe UI", "SF Pro Text", system-ui, sans-serif;
    font-size: 13px;
}

QMainWindow, QDialog {
    background-color: #121212;
    color: #FFFFFF;
}

QWidget {
    background-color: #121212;
    color: #FFFFFF;
}

QTabWidget::pane {
    border: 1px solid #333333;
    background-color: #1A1A1A;
}

QTabBar::tab {
    background-color: #1A1A1A;
    color: #B0B0B0;
    padding: 8px 16px;
    border: 1px solid #333333;
    border-bottom: none;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #202020;
    color: #FFFFFF;
    border-bottom: 2px solid #4F8CFF;
}

QTabBar::tab:hover {
    color: #FFFFFF;
}

QGroupBox {
    background-color: #1A1A1A;
    border: 1px solid #333333;
    border-radius: 4px;
    margin-top: 12px;
    padding-top: 16px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #B0B0B0;
}

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QComboBox {
    min-height: 20px;
    background-color: #202020;
    border: 1px solid #333333;
    border-radius: 3px;
    padding: 6px 8px;
    color: #FFFFFF;
    selection-background-color: #4F8CFF;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus {
    border: 1px solid #4F8CFF;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #202020;
    border: 1px solid #333333;
    selection-background-color: #4F8CFF;
    color: #FFFFFF;
}

QPushButton {
    background-color: #202020;
    border: 1px solid #333333;
    border-radius: 3px;
    padding: 6px 14px;
    color: #FFFFFF;
    min-height: 24px;
}

QPushButton:hover {
    background-color: #2A2A2A;
    border-color: #4F8CFF;
}

QPushButton:pressed {
    background-color: #333333;
}

QPushButton:disabled {
    color: #666666;
    border-color: #2A2A2A;
}

QPushButton#donateButton {
    background-color: #0C2451;
    border: 1px solid #1a3a6e;
    color: #FFFFFF;
    padding: 6px 14px;
    font-weight: 600;
}

QPushButton#donateButton:hover {
    background-color: #1a3a6e;
    border-color: #4F8CFF;
}

QPushButton#primaryButton {
    background-color: #4F8CFF;
    border: 1px solid #4F8CFF;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background-color: #3A7AEF;
}

QPushButton#dangerButton {
    background-color: #3A2020;
    border: 1px solid #8C4F4F;
    color: #FF8080;
}

QCheckBox {
    spacing: 6px;
    color: #FFFFFF;
    padding: 2px 0;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #666666;
    border-radius: 3px;
    background-color: #2A2A2A;
}

QCheckBox::indicator:hover {
    border-color: #4F8CFF;
}

QCheckBox::indicator:checked {
    background-color: #4F8CFF;
    border-color: #4F8CFF;
    image: none;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QTableWidget, QTableView {
    background-color: #1A1A1A;
    alternate-background-color: #202020;
    border: 1px solid #333333;
    gridline-color: #333333;
    color: #FFFFFF;
    selection-background-color: #2A4A8C;
    selection-color: #FFFFFF;
}

QTableWidget::item, QTableView::item {
    padding: 4px 8px;
}

QHeaderView::section {
    background-color: #202020;
    color: #B0B0B0;
    border: none;
    border-right: 1px solid #333333;
    border-bottom: 1px solid #333333;
    padding: 6px 8px;
    font-weight: 600;
}

QScrollBar:vertical {
    background-color: #1A1A1A;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #444444;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #555555;
}

QScrollBar:horizontal {
    background-color: #1A1A1A;
    height: 10px;
}

QScrollBar::handle:horizontal {
    background-color: #444444;
    border-radius: 4px;
    min-width: 30px;
}

QProgressBar {
    background-color: #202020;
    border: 1px solid #333333;
    border-radius: 3px;
    text-align: center;
    color: #FFFFFF;
    height: 20px;
}

QProgressBar::chunk {
    background-color: #4F8CFF;
    border-radius: 2px;
}

QSplitter::handle {
    background-color: #333333;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QStatusBar {
    background-color: #1A1A1A;
    color: #B0B0B0;
    border-top: 1px solid #333333;
}

QLabel#secondaryLabel {
    color: #B0B0B0;
}

QLabel#statsLabel {
    color: #4F8CFF;
    font-weight: 600;
}

QToolTip {
    background-color: #202020;
    color: #FFFFFF;
    border: 1px solid #4F8CFF;
    padding: 4px;
}
